# ========================================================
# OVEN & OAK — ENVIRONMENT VARIABLES CONFIGURATION
# ========================================================

# Supabase Project URL (Client & Server)
# Obtain this from your Supabase Project Settings > API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anonymous Public Key (Client-Safe)
# Used in the browser for anonymous customer browsing and order creation
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_ANON_KEY="your-anon-key-here"

# Supabase Service Role Key (SERVER-SIDE ONLY — NEVER EXPOSE IN CLIENT)
# Used strictly in server.ts for administrative operations, order creation, and storage uploads
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Admin Portal Password (SERVER-SIDE ONLY — NEVER EXPOSE IN CLIENT)
# Set your custom owner password to access /admin and protected admin APIs
ADMIN_PASSWORD="your-secure-admin-password"

# Optional Server Session Signing Secret (defaults to random CSPRNG secret at runtime if unset)
ADMIN_SESSION_SECRET=""

# Application URL
APP_URL="MY_APP_URL"

# Gemini API Key (Optional AI features)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
